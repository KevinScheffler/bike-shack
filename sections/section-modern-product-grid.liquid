{% comment %} Load component styles {% endcomment %}
{{ 'section-modern-product-grid.css' | asset_url | stylesheet_tag }}

{%- comment -%} Coerce the select value to an integer for paginate {%- endcomment -%}
{%- assign products_per_page = section.settings.products_per_page | plus: 0 -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ModernProductGrid-{{ section.id }} {
    --mpg-accent: {{ section.settings.accent_color | default: 'rgb(var(--color-link))' }};
  }
  #ModernProductGrid-{{ section.id }} .mpg-card__media-clip {
    clip-path: url(#mpg-notch-{{ section.id }});
  }
  @media screen and (max-width: 749px) {
    #ModernProductGrid-{{ section.id }} .mpg-card__media-clip {
      clip-path: url(#mpg-notch-sm-{{ section.id }});
    }
  }
{%- endstyle -%}

<div
  id="ModernProductGrid-{{ section.id }}"
  class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
>
  {%- comment -%} Notch-shaped clip for the card images (0..1 objectBoundingBox coords). {%- endcomment -%}
  <svg class="mpg-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      {%- comment -%}
        Notch starts at 46% of width, not the reference's 65%. The reference's cards
        are 450px wide (measured from reference/grid.png: a ~1914px layout), so its
        35%-wide notch is ~158px. Dawn's page width is 1200px, making our 4-column
        cards ~281px — the same 35% would be only ~98px, too narrow for the label.
        46% keeps the notch's size relative to its text, which is what the design
        depends on; copying the percentage would not.
      {%- endcomment -%}
      <clipPath id="mpg-notch-{{ section.id }}" clipPathUnits="objectBoundingBox">
        <path d="M 0.013,0 L 0.987,0 Q 1,0 1,0.013 L 1,0.9035 L 0.46,0.9035 C 0.41,0.9035 0.3533,1 0.3333,1 L 0.013,1 Q 0,1 0,0.987 L 0,0.013 Q 0,0 0.013,0 Z" />
      </clipPath>
      {%- comment -%}
        Small screens use a wider notch. The label needs roughly the same pixel
        width whatever the card size, so on a card half as wide the notch has to
        take a much bigger share of it. Measured from reference/mobile-1-two-column-layout.png:
        notch starts at 30.9% of width (vs 65% on desktop) at the same ~9% depth.
      {%- endcomment -%}
      <clipPath id="mpg-notch-sm-{{ section.id }}" clipPathUnits="objectBoundingBox">
        <path d="M 0.013,0 L 0.987,0 Q 1,0 1,0.013 L 1,0.911 L 0.309,0.911 C 0.2738,0.911 0.2341,1 0.22,1 L 0.013,1 Q 0,1 0,0.987 L 0,0.013 Q 0,0 0.013,0 Z" />
      </clipPath>
    </defs>
  </svg>

  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="mpg-header">
        <h2 class="mpg-header__title inline-richtext">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- paginate collection.products by products_per_page -%}
      {%- if collection.products.size == 0 -%}
        <div class="mpg-empty">
          <p class="mpg-empty__text">{{ 'sections.collection_template.empty' | t }}</p>
        </div>
      {%- else -%}
        <ul class="mpg-grid" role="list">
          {%- for product in collection.products -%}
            {%- if forloop.index <= 4 -%}
              {%- assign loading = 'eager' -%}
            {%- else -%}
              {%- assign loading = 'lazy' -%}
            {%- endif -%}

            {%- liquid
              assign img_alt = product.title | escape

              # Always `money`, never `money_with_currency`, even when the theme's
              # currency-code setting is on. The label lives in the card's notch, which
              # is only ~35% of the card's width on desktop; the trailing code (" USD")
              # costs ~30px and squeezes the product title out entirely. The code still
              # shows everywhere else in the theme, including the product page and cart.
              assign money_price = product.price | money
              assign money_price_min = product.price_min | money
            -%}
            <li class="mpg-card">
              <a class="mpg-card__link" href="{{ product.url }}">
                <span class="mpg-card__media">
                  <span class="mpg-card__media-clip">
                  {%- if product.featured_media -%}
                    {{
                      product.featured_media.preview_image
                      | image_url: width: 800
                      | image_tag:
                        loading: loading,
                        widths: '165, 265, 360, 535, 720',
                        sizes: '(min-width: 990px) 25vw, 50vw',
                        alt: img_alt,
                        class: 'mpg-card__img mpg-card__img--primary'
                    }}
                  {%- else -%}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'mpg-card__img mpg-card__img--primary mpg-card__placeholder' }}
                  {%- endif -%}

                  {%- if product.media.size > 1 -%}
                    {{
                      product.media[1].preview_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        widths: '165, 265, 360, 535, 720',
                        sizes: '(min-width: 990px) 25vw, 50vw',
                        alt: img_alt,
                        class: 'mpg-card__img mpg-card__img--secondary'
                    }}
                  {%- endif -%}

                  </span>{%- comment -%} end .mpg-card__media-clip {%- endcomment -%}

                  {%- comment -%}
                    Notched outline. Geometry traced pixel-by-pixel from
                    reference/card-reference.png (card measured 451x456 => square,
                    corner radius ~1.3% of width, notch top at 90.35% of height).
                    The notch side is a single cubic S-curve from 65% to 52.33% width,
                    leaving both ends horizontally tangent — not a stepped corner.
                  {%- endcomment -%}
                  <svg
                    class="mpg-card__frame"
                    viewBox="0 0 100 100"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      class="mpg-card__frame-path mpg-card__frame-path--lg"
                      vector-effect="non-scaling-stroke"
                      d="M 1.3,0 L 98.7,0 Q 100,0 100,1.3 L 100,90.35 L 46,90.35 C 41,90.35 35.33,100 33.33,100 L 1.3,100 Q 0,100 0,98.7 L 0,1.3 Q 0,0 1.3,0 Z"
                    />
                    <path
                      class="mpg-card__frame-path mpg-card__frame-path--sm"
                      vector-effect="non-scaling-stroke"
                      d="M 1.3,0 L 98.7,0 Q 100,0 100,1.3 L 100,91.1 L 30.9,91.1 C 27.38,91.1 23.41,100 22,100 L 1.3,100 Q 0,100 0,98.7 L 0,1.3 Q 0,0 1.3,0 Z"
                    />
                  </svg>

                  <span class="mpg-card__label">
                    <span class="mpg-card__title">{{ product.title }}</span>
                    <span class="mpg-card__price">
                      {%- if product.price_varies -%}
                        {{ 'products.product.price.from_price_html' | t: price: money_price_min }}
                      {%- else -%}
                        {{ money_price }}
                      {%- endif -%}
                    </span>
                  </span>
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <div class="mpg-pagination">
            {% render 'pagination', paginate: paginate, anchor: '' %}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Modern Product Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "products_per_page",
      "label": "Products per page",
      "default": "8",
      "options": [
        { "value": "4", "label": "4" },
        { "value": "8", "label": "8" },
        { "value": "12", "label": "12" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Used for the card outline highlight and the price. Defaults to the color scheme's link color when left empty."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Modern Product Grid"
    }
  ]
}
{% endschema %}
